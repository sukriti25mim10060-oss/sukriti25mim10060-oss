// Handwritten Digit Recognition using a Neural Network from Scratch
// Target: .NET 6+ Console Application
// Expected CSV format: label,pixel1,pixel2,...,pixel784
// Pixel values may be in the range 0-255 or 0-1.
//
// Run:
//   dotnet new console -n DigitRecognition
//   Replace DigitRecognition/Program.cs with this file
//   dotnet run --project DigitRecognition -- train.csv test.csv
//
// This educational implementation uses a 784-128-64-10 neural network.
// It does not require an external machine-learning library.

using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;

internal class Program
{
    private static void Main(string[] args)
    {
        if (args.Length < 2)
        {
            Console.WriteLine("Usage: dotnet run -- <train.csv> <test.csv>");
            Console.WriteLine("CSV format: label,pixel1,pixel2,...,pixel784");
            return;
        }

        string trainPath = args[0];
        string testPath = args[1];

        if (!File.Exists(trainPath) || !File.Exists(testPath))
        {
            Console.WriteLine("Could not find the training or test CSV file.");
            return;
        }

        Console.WriteLine("Loading training data...");
        List<Sample> trainingData = LoadCsv(trainPath);
        Console.WriteLine($"Loaded {trainingData.Count} training rows.");

        Console.WriteLine("Loading test data...");
        List<Sample> testData = LoadCsv(testPath);
        Console.WriteLine($"Loaded {testData.Count} test rows.");

        if (trainingData.Count == 0 || testData.Count == 0)
        {
            Console.WriteLine("No data was loaded. Check your CSV format.");
            return;
        }

        var network = new NeuralNetwork(inputSize: 784, hidden1: 128, hidden2: 64, outputSize: 10);
        const int epochs = 5;
        const double learningRate = 0.01;

        for (int epoch = 1; epoch <= epochs; epoch++)
        {
            Shuffle(trainingData);
            double totalLoss = 0;

            foreach (Sample sample in trainingData)
                totalLoss += network.TrainOne(sample.Pixels, sample.Label, learningRate);

            double accuracy = Evaluate(network, testData);
            Console.WriteLine(
                $"Epoch {epoch}/{epochs} | Loss: {totalLoss / trainingData.Count:F4} | Test accuracy: {accuracy:F2}%");
        }

        Console.WriteLine();
        Console.WriteLine("Enter the path to a digit CSV row file to predict, or press Enter to exit.");
        Console.WriteLine("The file should contain one row of 784 pixel values (without a label).");
        string? imagePath = Console.ReadLine();

        if (!string.IsNullOrWhiteSpace(imagePath) && File.Exists(imagePath))
        {
            double[] pixels = LoadPixelRow(imagePath);
            int prediction = network.Predict(pixels);
            Console.WriteLine($"Predicted digit: {prediction}");
        }
    }

    private static List<Sample> LoadCsv(string path)
    {
        var samples = new List<Sample>();
        bool firstLine = true;

        foreach (string line in File.ReadLines(path))
        {
            if (string.IsNullOrWhiteSpace(line))
                continue;

            string[] parts = line.Split(',', StringSplitOptions.TrimEntries);

            // Skip a header row if the first field is not numeric.
            if (firstLine && !int.TryParse(parts[0], NumberStyles.Integer,
                    CultureInfo.InvariantCulture, out _))
            {
                firstLine = false;
                continue;
            }

            firstLine = false;
            if (parts.Length < 785)
                continue;

            if (!int.TryParse(parts[0], NumberStyles.Integer,
                    CultureInfo.InvariantCulture, out int label) || label < 0 || label > 9)
                continue;

            var pixels = new double[784];
            bool valid = true;

            for (int i = 0; i < 784; i++)
            {
                if (!double.TryParse(parts[i + 1], NumberStyles.Float,
                        CultureInfo.InvariantCulture, out double value))
                {
                    valid = false;
                    break;
                }

                // Support either 0..255 or already-normalized 0..1 pixel values.
                pixels[i] = value > 1.0 ? value / 255.0 : value;
            }

            if (valid)
                samples.Add(new Sample(pixels, label));
        }

        return samples;
    }

    private static double[] LoadPixelRow(string path)
    {
        string? line = File.ReadLines(path).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
        if (line == null)
            throw new InvalidDataException("The image file is empty.");

        string[] parts = line.Split(',', StringSplitOptions.TrimEntries);

        // If the row contains a label plus 784 pixels, ignore the label.
        int start = parts.Length >= 785 ? 1 : 0;
        if (parts.Length - start < 784)
            throw new InvalidDataException("Expected 784 pixel values.");

        var pixels = new double[784];
        for (int i = 0; i < 784; i++)
        {
            double value = double.Parse(parts[start + i], CultureInfo.InvariantCulture);
            pixels[i] = value > 1.0 ? value / 255.0 : value;
        }

        return pixels;
    }

    private static double Evaluate(NeuralNetwork network, List<Sample> data)
    {
        int correct = 0;
        foreach (Sample sample in data)
        {
            if (network.Predict(sample.Pixels) == sample.Label)
                correct++;
        }

        return 100.0 * correct / data.Count;
    }

    private static void Shuffle<T>(IList<T> list)
    {
        for (int i = list.Count - 1; i > 0; i--)
        {
            int j = Random.Shared.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }
    }
}

internal sealed class Sample
{
    public double[] Pixels { get; }
    public int Label { get; }

    public Sample(double[] pixels, int label)
    {
        Pixels = pixels;
        Label = label;
    }
}

internal sealed class NeuralNetwork
{
    private readonly int[] _sizes;
    private readonly double[][] _biases;
    private readonly double[][][] _weights;
    private readonly Random _random = new();

    public NeuralNetwork(int inputSize, int hidden1, int hidden2, int outputSize)
    {
        _sizes = new[] { inputSize, hidden1, hidden2, outputSize };
        _biases = new double[_sizes.Length - 1][];
        _weights = new double[_sizes.Length - 1][][];

        for (int layer = 0; layer < _sizes.Length - 1; layer++)
        {
            _biases[layer] = new double[_sizes[layer + 1]];
            _weights[layer] = new double[_sizes[layer + 1]][];

            // He-style initialization for ReLU layers; small random values for output.
            double scale = Math.Sqrt(2.0 / _sizes[layer]);
            for (int neuron = 0; neuron < _sizes[layer + 1]; neuron++)
            {
                _weights[layer][neuron] = new double[_sizes[layer]];
                for (int previous = 0; previous < _sizes[layer]; previous++)
                    _weights[layer][neuron][previous] =
                        ( _random.NextDouble() * 2.0 - 1.0) * scale;
            }
        }
    }

    public int Predict(double[] input)
    {
        double[][] activations = Forward(input);
        double[] output = activations[^1];
        int best = 0;

        for (int i = 1; i < output.Length; i++)
            if (output[i] > output[best])
                best = i;

        return best;
    }

    public double TrainOne(double[] input, int label, double learningRate)
    {
        double[][] activations = Forward(input);
        int last = _sizes.Length - 1;
        double[] output = activations[last];
        double loss = -Math.Log(Math.Max(output[label], 1e-12));

        var deltas = new double[last][];
        deltas[last - 1] = new double[_sizes[last]];

        // Softmax + cross-entropy gradient.
        for (int i = 0; i < output.Length; i++)
            deltas[last - 1][i] = output[i] - (i == label ? 1.0 : 0.0);

        // Backpropagate through hidden layers.
        for (int layer = last - 2; layer >= 0; layer--)
        {
            deltas[layer] = new double[_sizes[layer + 1]];
            for (int neuron = 0; neuron < _sizes[layer + 1]; neuron++)
            {
                double error = 0;
                for (int next = 0; next < _sizes[layer + 2]; next++)
                    error += _weights[layer + 1][next][neuron] * deltas[layer + 1][next];

                double activation = activations[layer + 1][neuron];
                deltas[layer][neuron] = error * (activation > 0 ? 1.0 : 0.0);
            }
        }

        // Gradient-descent update.
        for (int layer = 0; layer < last; layer++)
        {
            for (int neuron = 0; neuron < _sizes[layer + 1]; neuron++)
            {
                _biases[layer][neuron] -= learningRate * deltas[layer][neuron];

                for (int previous = 0; previous < _sizes[layer]; previous++)
                {
                    _weights[layer][neuron][previous] -=
                        learningRate * deltas[layer][neuron] * activations[layer][previous];
                }
            }
        }

        return loss;
    }

    private double[][] Forward(double[] input)
    {
        if (input.Length != _sizes[0])
            throw new ArgumentException($"Expected {_sizes[0]} input values.");

        var activations = new double[_sizes.Length][];
        activations[0] = input;

        for (int layer = 0; layer < _sizes.Length - 1; layer++)
        {
            var values = new double[_sizes[layer + 1]];

            for (int neuron = 0; neuron < values.Length; neuron++)
            {
                double sum = _biases[layer][neuron];
                for (int previous = 0; previous < _sizes[layer]; previous++)
                    sum += _weights[layer][neuron][previous] * activations[layer][previous];

                values[neuron] = sum;
            }

            if (layer == _sizes.Length - 2)
                activations[layer + 1] = Softmax(values);
            else
            {
                for (int i = 0; i < values.Length; i++)
                    values[i] = Math.Max(0, values[i]); // ReLU
                activations[layer + 1] = values;
            }
        }

        return activations;
    }

    private static double[] Softmax(double[] values)
    {
        double max = values.Max();
        var exp = new double[values.Length];
        double sum = 0;

        for (int i = 0; i < values.Length; i++)
        {
            exp[i] = Math.Exp(values[i] - max);
            sum += exp[i];
        }

        for (int i = 0; i < exp.Length; i++)
            exp[i] /= sum;

        return exp;
    }
}
